# Clone do monorepo Hyperledger Cacti/Weaver (baixado por scripts/01-clone-weaver.sh)
/cacti/

# Binários compilados
/bin/
# `go build ./apps/x` deixa o binário com o nome do pacote, na raiz ou no
# diretório do módulo. Listados um a um porque são nomes sem extensão e um
# padrão genérico esconderia arquivos de verdade.
/htlc-orchestrator
/coordinator
/chaincode/twopc/twopc
*.exe
*.test
*.out

# Chaincode empacotado
*.tar.gz

# Resultados brutos dos experimentos. O agregado (aggregated.csv) é versionado;
# os CSVs e logs por execução, não — são reproduzíveis pelo runner.
/experiments/results/raw/
/experiments/results/.run-counter
/experiments/results/**/*.log

# Write-ahead log do coordenador (estado de execução, não código)
/apps/coordinator/wal/
*.wal

# Material de identidade do Fabric gerado localmente
/wallets/
/crypto-config/
*.pem
*.key

# Python
__pycache__/
.venv/
*.py[cod]
.venv/
venv/

# LaTeX (artigo)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc

# Sistema operacional / editor
.DS_Store
.idea/
.vscode/

# Figuras e tabelas são geradas por `make analyze` a partir do agregado.
# Versionar o gerado convida a divergir da fonte; o agregado é o que importa.
/docs/paper/figures/*.pdf
/docs/paper/figures/results.md
/docs/paper/figures/results.tex
