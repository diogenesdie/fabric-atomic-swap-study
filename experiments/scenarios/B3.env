# Baseline 2PC com fases SEQUENCIAIS.
# Controle para isolar quanto da vantagem do 2PC vem do paralelismo e quanto
# do protocolo: sem paralelizar, ele deve custar 4 rodadas de bloco como o HTLC.
PROTOCOL=2pc
DESCRIPTION="2PC sem falha, fases sequenciais"
DEADLINE=10m
PARALLEL=false
EXPECTED=COMMITTED_BOTH
