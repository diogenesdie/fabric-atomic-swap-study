# Atraso de rede consumindo a margem entre os dois prazos.
#
# Alice trava em A com prazo A+T1; bob trava em B com prazo B+T2. A proteção de
# bob exige B+T2 < A+T1. Sob atraso, (B-A) cresce e a margem some — e um
# cliente correto RECUSA travar em vez de se expor.
#
# Este cenário mede quanto atraso basta para isso. O desfecho esperado é aborto
# seguro, não violação: ver a nota sobre timestamp de proposta em
# docs/notas/fabric.md.
PROTOCOL=htlc
DESCRIPTION="HTLC: atraso consome a margem entre os prazos"
T1=30s
T2=25s
NETEM_DELAY=800ms
NETEM_TARGETS="peer0.org1.network1.com orderer.network1.com"
RECLAIM=true
EXPECTED=ABORTED_BOTH
NETEM_DURATION=28
