# Atraso de rede nas duas fases — o par do H3.
# A hipótese é que aqui o 2PC apenas fique mais lento, sem violar.
PROTOCOL=2pc
DESCRIPTION="2PC: atraso de rede nas duas fases"
DEADLINE=10m
NETEM_DELAY=800ms
NETEM_TARGETS="peer0.org1.network1.com orderer.network1.com"
EXPECTED=COMMITTED_BOTH
NETEM_DURATION=30
