# A válvula de escape disparando de forma ASSIMÉTRICA.
# O coordenador cai com a decisão de efetivar em disco; só um participante
# exerce o TimeoutAbort; a recuperação honra a decisão e efetiva o outro lado.
# É o cenário que refutou a hipótese original de que o 2PC não viola.
PROTOCOL=2pc
DESCRIPTION="2PC: prazo dispara em um só participante"
CRASH_AFTER=decision
DEADLINE=15s
TIMEOUT_ABORT_ON=network2
RECOVER=true
RECOVER_DELAY=18
EXPECTED=VIOLATED
