# Clock skew: o relógio de bob ATRASADO em relação ao da rede.
#
# O espelho do X1. Com o relógio atrasado, bob fixa um prazo mais cedo do que
# pretendia — o lock dele expira antes da hora — mas a verificação de margem,
# feita com o mesmo relógio, diz que está tudo bem. Ele acredita ter 50s de
# folga quando o próprio lock vence em 10s.
PROTOCOL=htlc
DESCRIPTION="HTLC: relógio de bob atrasado (clock skew)"
T1=60s
T2=30s
BOB_CLOCK_SKEW=-20s
RECLAIM=true
EXPECTED=COMMITTED_BOTH
